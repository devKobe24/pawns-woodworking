---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPosts } from '../posts';

const [latest, ...older] = await getPosts();
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			.tagline {
				margin: 0 0 2.5em;
				color: rgb(var(--gray));
				font-family: var(--font-serif);
				text-align: center;
			}
			/* Cover story: the newest post, magazine-cover size. */
			.cover {
				display: block;
				color: inherit;
				text-align: center;
				text-decoration: none;
			}
			/* Astro won't upscale, so a small source keeps its own ratio; fix the 2:1 frame here. */
			.cover img {
				display: block;
				width: 100%;
				aspect-ratio: 2 / 1;
				object-fit: cover;
				margin-bottom: 1.5em;
			}
			.cover h2 {
				max-width: 18em;
				margin: 0.3em auto;
				font-size: 3.2em;
				line-height: 1.2;
			}
			.cover:hover h2 {
				color: var(--accent);
			}
			.dek {
				max-width: 32em;
				margin: 0 auto 1.25em;
				font-size: 1.1em;
			}
			.more {
				color: var(--accent);
				font-size: 0.85em;
				font-weight: 700;
			}
			.older {
				max-width: 720px;
				margin: 3em auto 0;
				padding-top: 2.5em;
				border-top: 1px solid rgb(var(--black));
			}
			.all-posts {
				display: inline-block;
				margin-top: 1.5em;
				font-weight: 700;
			}
			@media (max-width: 720px) {
				.tagline {
					margin-bottom: 1.5em;
				}
				.cover h2 {
					font-size: 2.1em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1 class="sr-only">{SITE_TITLE}</h1>
			<p class="tagline">가구와 소품을 만들며 배운 것을 기록합니다.</p>
			{latest ? (
				<a class="cover" href={`/blog/${latest.id}/`}>
					{latest.data.heroImage && (
						<Image width={1440} height={720} src={latest.data.heroImage} alt="" />
					)}
					<p class="meta">
						최신 글 · <FormattedDate date={latest.data.pubDate} />
					</p>
					<h2>{latest.data.title}</h2>
					<p class="dek">{latest.data.description}</p>
					<span class="more">글 읽기 →</span>
				</a>
			) : (
				<p>아직 발행한 글이 없습니다. 첫 목공 기록을 준비하고 있습니다.</p>
			)}
			{older.length > 0 && (
				<section class="older">
					<h2 class="meta">지난 글</h2>
					<PostList posts={older} />
					<a class="all-posts" href="/blog">모든 글 보기 →</a>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>
