---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

// slug is set for blog posts only; it turns on the view counter.
type Props = CollectionEntry<'blog'>['data'] & { slug?: string };

const { title, description, pubDate, updatedDate, heroImage, slug } = Astro.props;
---

<html lang="ko">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			imageAlt={heroImage && title}
		/>
		<style>
			main {
				width: 960px;
			}
			.title {
				max-width: 720px;
				margin: 0 auto 2.5em;
				padding-bottom: 2em;
				border-bottom: 1px solid rgb(var(--black));
				text-align: center;
			}
			.title h1 {
				margin: 0.4em 0;
				line-height: 1.25;
			}
			.dek {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 1.1em;
			}
			.last-updated-on {
				margin-top: 0.5em;
				font-style: italic;
			}
			.hero-image img {
				display: block;
				width: 100%;
				margin-bottom: 2.5em;
			}
			.prose {
				max-width: 680px;
				margin: 0 auto;
			}
			.prose :global(img) {
				display: block;
				margin: 2em auto;
			}
			/* Drop cap on the opening paragraph; flow-root keeps a short paragraph from wrapping the next one. */
			.prose > :global(p:first-of-type) {
				display: flow-root;
			}
			.prose > :global(p:first-of-type)::first-letter {
				float: left;
				margin: 0.1em 0.12em 0 0;
				color: var(--accent);
				font-family: var(--font-serif);
				font-size: 3.4em;
				font-weight: 700;
				line-height: 1;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="title">
					<p class="meta">
						<FormattedDate date={pubDate} />
						{slug && (
							<span class="views" data-slug={slug} hidden>
								· 조회 <span class="count" />
							</span>
						)}
					</p>
					<h1>{title}</h1>
					<p class="dek">{description}</p>
					{updatedDate && (
						<p class="meta last-updated-on">
							Last updated on <FormattedDate date={updatedDate} />
						</p>
					)}
				</div>
				{heroImage && (
					<div class="hero-image">
						<Image width={1440} height={720} src={heroImage} alt="" />
					</div>
				)}
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
		<script>
			// Count one view per browser session, then show the total. Stays hidden if the API is unavailable.
			const views = document.querySelector<HTMLElement>('.views');
			if (views) {
				const key = `viewed:${views.dataset.slug}`;
				let counted = false;
				try {
					counted = sessionStorage.getItem(key) !== null;
				} catch {}
				fetch(`/api/views/${views.dataset.slug}`, { method: counted ? 'GET' : 'POST' })
					.then((res) => (res.ok ? res.json() : Promise.reject(res.status)))
					.then(({ count }) => {
						try {
							sessionStorage.setItem(key, '1');
						} catch {}
						views.querySelector('.count')!.textContent = count.toLocaleString('ko-KR');
						views.hidden = false;
					})
					.catch(() => {});
			}
		</script>
	</body>
</html>
