---
import InstagramIcon from './InstagramIcon.astro';
import { INSTAGRAM_URL, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<a class="site-title" href="/">{SITE_TITLE}</a>
	<nav>
		<HeaderLink href="/">Home</HeaderLink>
		<HeaderLink href="/blog">Blog</HeaderLink>
		<HeaderLink href="/about">About</HeaderLink>
		<a class="social-link" href={INSTAGRAM_URL} target="_blank">
			<span class="sr-only">Instagram에서 pawn.wood 팔로우하기</span>
			<InstagramIcon />
		</a>
	</nav>
</header>
<style>
	/* Newspaper masthead: centered name above a menu framed by rules. */
	header {
		width: 960px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding-top: 2em;
		text-align: center;
	}
	.site-title {
		display: block;
		padding-bottom: 0.4em;
		color: rgb(var(--black));
		font-family: var(--font-serif);
		font-size: 2.2em;
		font-weight: 700;
		line-height: 1.2;
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.5em;
		border-top: 1px solid rgb(var(--black));
		border-bottom: 1px solid var(--rule);
	}
	nav :global(a) {
		padding: 0.6em 0;
		color: rgb(var(--black));
		font-size: 0.8em;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-decoration: none;
	}
	nav :global(a.active) {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 0.4em;
	}
	.social-link {
		display: flex;
	}
	.social-link :global(svg) {
		width: 1.2em;
		height: 1.2em;
	}
	@media (max-width: 720px) {
		header {
			padding-top: 1.25em;
		}
		.site-title {
			font-size: 1.5em;
		}
	}
</style>
