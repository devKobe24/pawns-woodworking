---
// Giscus stores comments in this repo's GitHub Discussions (Announcements category).
---

<section class="comments">
	<h2 class="meta">댓글</h2>
	<script
		is:inline
		src="https://giscus.app/client.js"
		data-repo="devKobe24/pawns-woodworking"
		data-repo-id="R_kgDOVt3g-A"
		data-category="Announcements"
		data-category-id="DIC_kwDOVt3g-M4DLKlK"
		data-mapping="pathname"
		data-strict="1"
		data-reactions-enabled="1"
		data-emit-metadata="0"
		data-input-position="bottom"
		data-theme="light"
		data-lang="ko"
		data-loading="lazy"
		crossorigin="anonymous"
		async></script>
</section>
<style>
	.comments {
		margin-top: 4em;
		padding-top: 2em;
		border-top: 1px solid rgb(var(--black));
	}
	h2 {
		margin-bottom: 1.5em;
	}
</style>
