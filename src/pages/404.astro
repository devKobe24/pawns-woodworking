---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title="페이지를 찾을 수 없습니다" description="요청한 주소의 페이지가 없습니다." />
		<meta name="robots" content="noindex" />
		<style>
			main {
				text-align: center;
			}
			.links {
				display: flex;
				justify-content: center;
				gap: 1.5em;
				font-weight: 700;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="meta">404</p>
			<h1>페이지를 찾을 수 없습니다</h1>
			<p>주소가 바뀌었거나 삭제된 페이지입니다.</p>
			<p class="links">
				<a href="/">홈으로</a>
				<a href="/blog">모든 글 보기</a>
			</p>
		</main>
		<Footer />
	</body>
</html>
