---
interface Props {
	tags: string[];
	// Post count per tag, shown next to each tag when given.
	counts?: Map<string, number>;
	// The tag whose page this is, highlighted in the list.
	current?: string;
}

const { tags, counts, current } = Astro.props;
---

{tags.length > 0 && (
	<ul>
		{tags.map((tag) => (
			<li>
				<a href={`/tags/${tag}/`} aria-current={tag === current ? 'page' : undefined}>
					#{tag}
					{counts && <span class="count">{counts.get(tag)}</span>}
				</a>
			</li>
		))}
	</ul>
)}
<style>
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	a {
		display: inline-flex;
		gap: 0.4em;
		padding: 0.25em 0.8em;
		border: 1px solid var(--rule);
		border-radius: 999px;
		color: rgb(var(--gray-dark));
		font-size: 0.8em;
		text-decoration: none;
	}
	a:hover,
	a[aria-current='page'] {
		border-color: var(--accent);
		color: var(--accent);
	}
	.count {
		color: rgb(var(--gray));
	}
</style>
