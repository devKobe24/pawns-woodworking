---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/pawns-woodworking-og.jpg';
import { SITE_TITLE } from '../consts';
import { getImage } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	imageAlt?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage, imageAlt = SITE_TITLE } = Astro.props;
// Crop and compress to the 1200x630 JPEG that social previews expect. Astro won't upscale,
// so a narrower image gets the largest crop of that shape it can fill.
const width = Math.min(1200, image.width);
const ogImage = await getImage({ src: image, width, height: Math.round((width * 630) / 1200), format: 'jpg' });
const imageURL = new URL(ogImage.src, Astro.site ?? Astro.url);
const pageTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
<link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
<link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Search engine ownership verification -->
<meta name="google-site-verification" content="6vC-6S5ophaS8PxzzX1MKRfX1CjMtuUKdpLb5aCsxNs" />
<meta name="naver-site-verification" content="f91eb5fc41ff0d31fcddb5bb4fa1e996fa5dd856" />

<!-- Headline serif only; body text uses the device's Korean gothic font. -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	rel="stylesheet"
	href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@700&display=swap"
/>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="ko_KR" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:width" content={ogImage.attributes.width} />
<meta property="og:image:height" content={ogImage.attributes.height} />
<meta property="og:image:alt" content={imageAlt} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={imageAlt} />
