---
import InstagramIcon from './InstagramIcon.astro';
import { INSTAGRAM_URL, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2>
			<a href="/">{SITE_TITLE}</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<a href={INSTAGRAM_URL} target="_blank">
				<span class="sr-only">Instagram에서 pawn.wood 팔로우하기</span>
				<InstagramIcon />
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--paper);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
		/* Stack the site name above the menu so neither wraps on phones. */
		nav {
			flex-direction: column;
			align-items: flex-start;
		}
		h2 a {
			display: block;
			padding: 0.75em 0 0.25em;
		}
		.internal-links {
			display: flex;
			gap: 0.5em;
			margin-left: -0.5em;
		}
		.internal-links a {
			padding: 0.5em;
		}
	}
</style>
